# Copia este archivo como .env.production en el servidor, ANTES de ejecutar
# "npm run build". Next.js incrusta este valor en el sitio al compilar, así
# que si lo cambias después debes volver a compilar (npm run build).

# Dirección pública de la API (backend), con https y sin barra al final.
NEXT_PUBLIC_API_URL=https://api.TU_DOMINIO
